# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Where new leads get emailed
NOTIFY_EMAIL_TO=Info@pilot.estate
# Private internal BCC — sees every lead too, but is never exposed to the
# frontend or shown anywhere on the site. Read only by this backend.
NOTIFY_EMAIL_CC=a.marketeereg@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pilot Website <no-reply@pilot.estate>"

# Optional: protects GET /api/leads
ADMIN_KEY=

# Mr. Livo — AI sales assistant.
# Every reply is generated live by the model grounded in the SYSTEM_PROMPT
# in server.js — there are no canned replies.
#
# Pre-set below to Google Gemini's free tier (best quality/cost for this
# use case, and strong with Egyptian Arabic). Just paste your key from
# aistudio.google.com/apikey on the OPENAI_API_KEY line — nothing else to
# change.
#
# Other options (paid, generally higher quality) — replace the four lines
# below with one of these blocks instead:
#
# ChatGPT proper:
#   OPENAI_BASE_URL=
#   OPENAI_API_KEY=<key from platform.openai.com>
#   OPENAI_MODEL=gpt-4o-mini
#
# Claude:
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=<key from console.anthropic.com>
#   ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# Groq (free, no credit card, but weaker Arabic than Gemini):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<key from console.groq.com/keys>
#   OPENAI_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
